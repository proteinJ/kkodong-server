# 이 파일을 복사해서 .env로 만들고 실제 값을 채우세요.
# cp .env.example .env
# .env는 .gitignore에 이미 등록되어 있어 커밋되지 않습니다.

# --- Database (Supabase Postgres — Session Pooler, IPv4 호환) ---
# Supabase 대시보드 > Project Settings > Database > Connection string > Session pooler 탭에서 확인
DB_URL=jdbc:postgresql://aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.tqrgfwjwflsxnoltwprh
DB_PASSWORD=여기에_실제_Supabase_DB_비밀번호_입력

# --- Redis (로컬 개발 시 brew services start redis 로 먼저 띄워둘 것) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ---
# 운영 배포 시에는 충분히 긴 랜덤 문자열로 반드시 교체할 것 (예: openssl rand -base64 64)
JWT_SECRET=local-dev-only-change-this-to-a-long-random-secret
JWT_AT_VALIDITY=3600000
JWT_RT_VALIDITY=604800000

# --- Server ---
SERVER_PORT=8080

# --- JPA (로컬 개발 중 스키마 문제 디버깅 시에만 update로 바꾸기, 평소엔 validate 유지) ---
JPA_DDL_AUTO=validate
