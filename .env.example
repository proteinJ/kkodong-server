# 이 파일을 복사해서 .env로 만들고 실제 값을 채우세요.
# cp .env.example .env
# .env는 .gitignore에 이미 등록되어 있어 커밋되지 않습니다.

# --- Database (Supabase Postgres — Session Pooler, IPv4 호환) ---
# Supabase 대시보드 > Project Settings > Database > Connection string > Session pooler 탭에서 확인
DB_URL=jdbc:postgresql://aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.tqrgfwjwflsxnoltwprh
DB_PASSWORD=여기에_실제_Supabase_DB_비밀번호_입력

# --- Redis (로컬 개발 시 brew services start redis 로 먼저 띄워둘 것) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ---
# 운영 배포 시에는 충분히 긴 랜덤 문자열로 반드시 교체할 것 (예: openssl rand -base64 64)
JWT_SECRET=local-dev-only-change-this-to-a-long-random-secret
JWT_AT_VALIDITY=3600000
JWT_RT_VALIDITY=604800000

# --- Server ---
SERVER_PORT=8080

# --- Sign in with Apple ---
# Xcode 프로젝트의 Bundle Identifier (identity_token의 aud claim과 대조 검증)
APPLE_BUNDLE_ID=com.pawwalk.ios

# --- JPA (로컬 개발 중 스키마 문제 디버깅 시에만 update로 바꾸기, 평소엔 validate 유지) ---
JPA_DDL_AUTO=validate

# --- Cloudflare R2 (반려견 이미지 업로드, S3 호환 — 무료 티어: 10GB 저장 + egress 무료) ---
# Cloudflare 대시보드 > R2 > 버킷 생성 > "R2 API 토큰"에서 Access Key/Secret Key 발급
R2_ENDPOINT=https://여기에_계정ID.r2.cloudflarestorage.com
R2_ACCESS_KEY=여기에_R2_액세스_키
R2_SECRET_KEY=여기에_R2_시크릿_키
R2_BUCKET=kkodong
# 버킷의 Public Development URL 또는 연결한 커스텀 도메인
R2_PUBLIC_URL=https://여기에_공개_URL

# --- NaverMap API (지도 — 매장 위치 표시·검색) ---
# Naver Cloud Platform 콘솔 > AI·NAVER API > Maps 에서 애플리케이션 등록 후 발급
# ⚠️ 실제 키는 .env에만 둔다. 이 파일(.env.example)은 커밋되므로 자리표시자만 유지할 것.
NAVER_MAP_CLIENT_ID=여기에_클라이언트_ID
NAVER_MAP_CLIENT_SECRET=여기에_클라이언트_시크릿

# --- 국세청 사업자 진위확인 (PN-02, FR-PN02-01) ---
# 공공데이터포털(data.go.kr) > "국세청_사업자등록정보 진위확인 및 상태조회" 활용신청 후
# 마이페이지 > 인증키(Decoding) 복사. 무료이며 승인이 즉시 난다.
# ⚠️ 운영에서는 반드시 true. 꺼져 있으면 매장이 검증되지 않은 PENDING으로 남아
#    견주 앱(KG-01)에 노출되지 않는다 — 통과시킨 척하지는 않는다.
NTS_VERIFICATION_ENABLED=false
NTS_SERVICE_KEY=여기에_공공데이터포털_인증키
